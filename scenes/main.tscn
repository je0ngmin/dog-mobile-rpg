[sub_resource type="Shader" id="Shader_boss_atmosphere"]
code = "shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 centered = UV - vec2(0.5);
	centered.x *= 1.78;
	float distance_from_center = length(centered);
	float vignette = smoothstep(0.28, 0.88, distance_from_center);
	vec3 center_tint = vec3(0.24, 0.015, 0.02);
	vec3 edge_tint = vec3(0.015, 0.0, 0.005);
	vec3 tint = mix(center_tint, edge_tint, vignette);
	float alpha = intensity * (0.13 + vignette * 0.62);
	COLOR = vec4(tint, alpha);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_boss_atmosphere"]
shader = SubResource("Shader_boss_atmosphere")
shader_parameter/intensity = 0.0

[sub_resource type="Shader" id="Shader_stage_transition"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform float uncover : hint_range(0.0, 1.0) = 0.0;
uniform float softness : hint_range(0.01, 0.3) = 0.12;

void fragment() {
	float front = 1.0 + softness - progress * (1.0 + softness * 2.0);
	float covered = smoothstep(front - softness, front + softness, UV.x);
	float alpha = mix(covered, 1.0 - covered, uncover);
	COLOR = vec4(0.0, 0.0, 0.0, alpha);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_stage_transition"]
shader = SubResource("Shader_stage_transition")
shader_parameter/progress = 0.0
shader_parameter/uncover = 0.0
shader_parameter/softness = 0.12

